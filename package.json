{
  "name": "tty.blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-content.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "build:content": "node scripts/build-content.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@fontsource/maple-mono": "^5.3.0",
    "@speed-highlight/core": "^2.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^18.2.1",
    "xterm-readline": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@xterm/headless": "^6.0.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
